# ───────── Where submissions are stored (Google Drive) ─────────
# URL of the deployed Apps Script web app (google-apps-script/Code.gs) and the shared secret that is also in that script.
# If these are empty, submissions are saved to ./submissions on this computer (development only;
# in production the form says "Submissions are not available").
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ───────── Site behaviour ─────────
NEXT_PUBLIC_SUBMISSIONS_OPEN=true
NEXT_PUBLIC_DEADLINE_TEXT=9 December 2026
NEXT_PUBLIC_MAX_FILE_MB=25
# Set to true only for a single self-hosted server with a writable disk and no Google Drive
ALLOW_LOCAL_STORAGE=false
